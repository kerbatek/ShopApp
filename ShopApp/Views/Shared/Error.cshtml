@model ShopApp.ViewModels.ErrorViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Error {Model.StatusCode}";
}

<div class="error-container" style="text-align: center; padding: 2rem;">
    <div style="font-size: 4rem; font-weight: bold; margin-bottom: 1rem;">
        @Model.StatusCode
    </div>
    <div style="font-size: 1.5rem; margin-bottom: 2rem;">
        @Model.Message
    </div>

    <div>
        <a href="~/"
           style="padding: 0.5rem 1rem; background-color: #007bff; color: white; border-radius: 5px; text-decoration: none;">
            Return to Home
        </a>
    </div>
</div>